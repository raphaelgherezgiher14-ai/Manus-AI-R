-- ---------------------------------------------------------------------------
-- 1) Tax / banking fields
-- ---------------------------------------------------------------------------
alter table public.companies
  add column if not exists vat_status text not null default 'regelbesteuert' check (vat_status in ('kleinunternehmer', 'regelbesteuert')),
  add column if not exists default_vat_rate numeric(5,2) not null default 19 check (default_vat_rate in (7, 19)),
  add column if not exists tax_number text,
  add column if not exists iban text,
  add column if not exists bic text,
  add column if not exists bank_name text;

alter table public.quotes
  add column if not exists vat_rate numeric(5,2),
  add column if not exists net_total numeric(14,2) not null default 0,
  add column if not exists vat_amount numeric(14,2) not null default 0;

alter table public.invoices
  add column if not exists vat_rate numeric(5,2),
  add column if not exists net_total numeric(14,2) not null default 0,
  add column if not exists vat_amount numeric(14,2) not null default 0,
  add column if not exists service_date date;

-- Backfill: existing amounts assumed gross incl. 19% VAT
update public.quotes set
  vat_rate = 19,
  net_total = round(total / 1.19, 2),
  vat_amount = total - round(total / 1.19, 2)
where total > 0;

